[Unit]
Description=celery beat scheduler for School Management System
After=network.target

[Service]
User=school
Group=school
WorkingDirectory=/var/www/school_backend
Environment="DJANGO_SETTINGS_MODULE=core.settings_production"
EnvironmentFile=/var/www/school_backend/.env
ExecStart=/var/www/school_backend/venv/bin/celery -A core beat -l info
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
