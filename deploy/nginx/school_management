# Nginx config for School Management System
# Place at: /etc/nginx/sites-available/school_management
# Enable with: ln -s /etc/nginx/sites-available/school_management /etc/nginx/sites-enabled/
# Remove default: rm /etc/nginx/sites-enabled/default

# Request limits per client IP (coarse DoS guard; fine-grained login/payment limits live in Django).
# 30 r/s with a burst of 100 comfortably covers a school behind one NAT.
limit_req_zone $binary_remote_addr zone=lp_api:10m rate=30r/s;
limit_req_status 429;

# HTTP - redirect to HTTPS
server {
    listen 80;
    server_name codingclubskenya.com www.codingclubskenya.com;
    return 301 https://$host$request_uri;
}

# HTTPS
server {
    listen 443 ssl http2;
    server_name codingclubskenya.com www.codingclubskenya.com;

    # SSL certificates (obtain via certbot)
    ssl_certificate /etc/letsencrypt/live/codingclubskenya.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codingclubskenya.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";

    # Client upload size (for file uploads via admin/mobile)
    client_max_body_size 50M;

    # React frontend served at /schoolsystem/
    location /schoolsystem/ {
        alias /home/personal/personalweb/frontend-apk-web/;
        try_files $uri $uri/ /schoolsystem/index.html;
    }

    # Redirect root and any non-API/non-admin paths to /schoolsystem/
    location = / {
        return 301 /schoolsystem/;
    }

    location / {
        return 301 /schoolsystem/;
    }

    # Django API
    location /api/ {
        limit_req zone=lp_api burst=100 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # Django admin
    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django static files
    location /static/ {
        alias /home/personal/personalweb/epk/backend/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Private uploads (CVs, student work, evidence, internal documents) are never
    # served directly: Django checks the permission, then nginx streams the file
    # from the internal location below (X-Accel-Redirect). Keep this prefix list
    # in sync with core/private_files.py PRIVATE_PREFIXES (a test enforces it).
    location ~* ^/media/(recruitment|assessment_evidence|reference_documents|scheme_uploads|course_attachments|course_materials|submissions|form_submissions|disputes)/ {
        return 404;
    }

    location /protected-media/ {
        internal;
        alias /home/personal/personalweb/epk/backend/media/;
        add_header X-Content-Type-Options nosniff always;
    }

    # Public media (product images, logos, website images)
    location /media/ {
        alias /home/personal/personalweb/epk/backend/media/;
        expires 7d;
    }
}