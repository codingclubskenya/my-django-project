[Unit]
Description=gunicorn daemon for School Management System
After=network.target

[Service]
User=school
Group=school
WorkingDirectory=/var/www/school_backend
Environment="DJANGO_SETTINGS_MODULE=core.settings_production"
EnvironmentFile=/var/www/school_backend/.env
ExecStart=/var/www/school_backend/venv/bin/gunicorn \
  --config /var/www/school_backend/gunicorn.conf.py \
  core.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
